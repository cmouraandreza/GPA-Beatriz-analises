"Bougainvilliidae",
"Eudendriidae",
"Pennariidae",
"Campanulariidae",
"Campanulinidae",
"Lafoeidae",
"Haleciidae",
"Halopterididae",
"Hebellidae",
"Aglaopheniidae",
"Plumulariidae",
"Sertularellidae",
"Sertulariidae",
"Syntheciidae",
"Symplectoscyphidae",
"Tiarannidae",
"Thyroscyphidae",
"Tubulariidae",
"Zygophylacidae"
)
df_percentual_geral <- df_percentual_geral %>%
mutate(
family = factor(
family,
levels = rev(ordem_familias)
)
)
g_percentual_geral <- ggplot(
df_percentual_geral,
aes(
x = family,
y = percentual_geral,
fill = grupo
)
) +
geom_col(
width = 0.75,
color = "white",
linewidth = 0.35
) +
geom_text(
aes(
label = ifelse(
percentual_geral >= 1,
paste0(
n,
" (",
round(percentual_geral, 1),
"%)"
),
""
)
),
position = position_stack(vjust = 0.5),
angle = 0,
color = "gray12",
fontface = "bold",
size = 3.4
) +
coord_flip() +
scale_y_continuous(
labels = scales::label_percent(scale = 1),
expand = expansion(mult = c(0, 0.05))
) +
scale_fill_manual(
values = c(
"Epibionts" = "#FBE4CE",
"Basibionts" = "#C2CED2"
)
) +
labs(
x = "Families",
y = "Relative frequency of total records (%)",
title = "(a) Relative frequency of family records in the overall dataset"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
legend.position = "right",
legend.direction = "vertical"
)
g_percentual_geral
df_empilhado_generos <- df_long_generos %>%
# Total geral de TODOS os registros de gênero
dplyr::mutate(
total_geral = sum(n, na.rm = TRUE)
) %>%
# Total de cada gênero: Epibionts + Basibionts
dplyr::group_by(genus) %>%
dplyr::mutate(
total_registros = sum(n, na.rm = TRUE)
) %>%
dplyr::ungroup() %>%
# Percentual de cada gênero/grupo em relação ao banco completo
dplyr::mutate(
percentual_geral = 100 * n / total_geral
) %>%
# Mantém somente gêneros com mais de 30 registros
dplyr::filter(
total_registros > 30
)
ordem_generos <- c(
# Atecados
"Bimeria",
"Eudendrium",
# Campanulariidae
"Campanularia",
"Clytia",
"Obelia",
# Hebellidae
"Hebella",
# Lafoeidae
"Filellum",
# Haleciidae
"Halecium",
# Plumularioidea
# Aglaopheniidae
"Aglaophenia",
"Lytocarpia",
# Plumulariidae
"Antennella",
"Plumularia",
"Nemertesia",
# Sertularioidea
# Sertularellidae
"Sertularella",
# Sertulariidae
"Tridentata",
"Diphasia",
# Syntheciidae
"Synthecium",
# Symplectoscyphidae
"Symplectoscyphus",
# Tiarannidae
"Modeeria",
# Thyroscyphidae
"Thyroscyphus",
# Tubulariidae
"Tubularia"
)
df_empilhado_generos <- df_empilhado_generos %>%
dplyr::mutate(
genus = factor(
genus,
levels = rev(ordem_generos)
)
)
g_generos <- ggplot(
df_empilhado_generos,
aes(
x = genus,
y = percentual_geral,
fill = grupo
)
) +
geom_col(
width = 0.75,
color = "white",
linewidth = 0.35
) +
geom_text(
aes(
label = ifelse(
percentual_geral >= 1,
paste0(
n,
" (",
round(percentual_geral, 1),
"%)"
),
""
)
),
position = position_stack(vjust = 0.5),
angle = 0,
color = "gray20",
fontface = "bold",
size = 3.4
) +
coord_flip() +
scale_y_continuous(
labels = scales::label_percent(scale = 1),
expand = expansion(mult = c(0, 0.05))
) +
scale_fill_manual(
values = c(
"Epibionts" = "#FBE4CE",
"Basibionts" = "#C2CED2"
)
) +
labs(
x = "Genus",
y = "Relative frequency of total records (%)",
title = "(a) Relative frequency of genus records in the overall dataset"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
axis.text.y = element_text(
face = "italic"
),
legend.position = "right",
legend.direction = "vertical"
)
g_generos
df_long_generos <- df %>%
tidyr::pivot_longer(
cols = c(genero_ep, genero_basi),
names_to = "grupo",
values_to = "genus"
) %>%
dplyr::filter(
!is.na(genus),
genus != ""
) %>%
dplyr::mutate(
grupo = dplyr::recode(
grupo,
genero_ep = "Epibionts",
genero_basi = "Basibionts"
)
) %>%
# Conta os registros de cada gênero em cada grupo
dplyr::count(
genus,
grupo,
name = "n"
) %>%
# Cria combinações ausentes com n = 0
tidyr::complete(
genus,
grupo = c("Epibionts", "Basibionts"),
fill = list(n = 0)
)
df_long_generos <- df %>%
tidyr::pivot_longer(
cols = c(genero_ep, genero_basi),
names_to = "grupo",
values_to = "genus"
) %>%
dplyr::filter(
!is.na(genus),
genus != ""
) %>%
dplyr::mutate(
grupo = dplyr::recode(
grupo,
genero_ep = "Epibionts",
genero_basi = "Basibionts"
)
) %>%
# Número de registros de cada gênero em cada grupo
dplyr::count(
genus,
grupo,
name = "n"
) %>%
# Garante que cada gênero tenha epi e basi
tidyr::complete(
genus,
grupo = c("Epibionts", "Basibionts"),
fill = list(n = 0)
) %>%
# IMPORTANTE: remove qualquer agrupamento residual
dplyr::ungroup()
total_geral_generos <- sum(
df_long_generos$n,
na.rm = TRUE
)
total_geral_generos
