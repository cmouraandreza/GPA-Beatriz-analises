df_long_generos <- df %>%
tidyr::pivot_longer(
cols = c(genero_ep, genero_basi),
names_to = "grupo",
values_to = "genus"  ) %>%
dplyr::filter(
!is.na(genus),
genus != ""  ) %>%
dplyr::mutate(
grupo = dplyr::recode(
grupo,
genero_ep = "Epibionts",
genero_basi = "Basibionts")  ) %>%
dplyr::count(
genus,
grupo,
name = "n"
) %>%
tidyr::complete(
genus,
grupo = c("Epibionts", "Basibionts"),
fill = list(n = 0)) %>%
dplyr::group_by(genus) %>%
dplyr::mutate(total_registros = sum(n, na.rm = TRUE)) %>%
dplyr::ungroup() %>%
dplyr::filter(total_registros > 20) %>%
dplyr::mutate(
n = dplyr::if_else(
grupo == "Basibionts",
-n,
n ),
genus = forcats::fct_reorder(
genus,
total_registros,
.desc = FALSE )) %>%
dplyr::group_by(grupo) %>%
dplyr::mutate(
total_abs = sum(abs(n), na.rm = TRUE),
percentual = 100 * n / total_abs
) %>%
dplyr::ungroup()
